# ----------------------------------------------------------------------------
# LowerMyBills environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# ----------------------------------------------------------------------------

# --- Anthropic (REQUIRED for bill analysis to work) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the model. Defaults to claude-opus-4-8.
# For lower cost at high volume, use: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth.js / NextAuth (REQUIRED) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# --- Google SSO (OPTIONAL tonight — leave blank to use the demo login) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):   https://YOURDOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Demo login toggle ---
# When Google is not configured, a one-click "Demo" sign-in is enabled
# automatically so you can use the app immediately. Set to "false" in
# production once Google SSO is live to disable the demo login entirely.
ENABLE_DEMO_LOGIN=true
